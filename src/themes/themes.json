        "src/themes/win95/desktop.css"
      ],
      "frameCss": [
        "src/themes/win95/vendor/98.css",
        "src/themes/win95/frame.css"
      ],
      "wallpaper": "#008080",
      "startLabel": "Démarrer",
      "window": {
        "className": "window",
        "titleBar": "title-bar",
        "titleBarText": "title-bar-text",
